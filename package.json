{
  "name": "gha-dash",
  "version": "1.0.1",
  "description": "GitHub Actions dashboard — workflow status across multiple orgs/accounts",
  "type": "module",
  "bin": {
    "gha-dash": "dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/cli.ts --no-open",
    "dev:client": "vite --config src/client/vite.config.ts --open",
    "build:server": "tsup && printf '#!/usr/bin/env node\\n' | cat - dist/cli.js > dist/cli.tmp && mv dist/cli.tmp dist/cli.js",
    "build:client": "vite build --config src/client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint src/",
    "check:npm": "node scripts/check-npm-version.mjs",
    "install:deps": "node scripts/check-npm-version.mjs && npm install --ignore-scripts",
    "update": "node scripts/check-npm-version.mjs && run-p update:*",
    "update:ncu": "node scripts/check-npm-version.mjs && npm-check-updates --upgrade --install always",
    "install:pinact": "go install github.com/suzuki-shunsuke/pinact/v3/cmd/pinact@latest",
    "update:pinact": "pinact run -u",
    "preflight": "npm run update && npm run fmt && npm run lint && npm run build && npm run test"
  },
  "keywords": [
    "github",
    "actions",
    "dashboard",
    "workflow",
    "ci",
    "cd"
  ],
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photostructure/gha-dash.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "express": "^5.2.1",
    "p-limit": "7.3.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "26.1.1",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-vue": "6.0.8",
    "concurrently": "10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "msw": "2.15.0",
    "npm-check-updates": "22.2.9",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.8"
  }
}
